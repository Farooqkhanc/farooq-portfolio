{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/img/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/logos/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/vid/:path*",
      "destination": "/:path*"
    }
  ]
}